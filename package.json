    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "agent:install": "npm --prefix agent install",
    "agent:dev": "AGENT_AUTH_DISABLED=1 npm --prefix agent run dev",
    "desktop:dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on http://localhost:8080 && cd electron && npm run build && electron .\"",
    "desktop:build:web": "cross-env ELECTRON_BUILD=1 vite build",
    "desktop:build:main": "tsc -p electron/tsconfig.json",
    "desktop:package": "node scripts/package-electron.mjs --target=all",
    "desktop:package:win": "node scripts/package-electron.mjs --target=win",
    "desktop:package:mac": "node scripts/package-electron.mjs --target=mac",
    "desktop:package:linux": "node scripts/package-electron.mjs --target=linux",
    "desktop:rebuild": "cd electron && npx electron-rebuild",
    "typecheck:landed-costs": "tsgo -p tsconfig.landed-costs.json"
  },
