{
  "name": "@accrualflow/edge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AccrualFlow Edge Desktop — tray-based operator console for enrolling and diagnosing an AccrualFlow Edge workstation.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "package:linux": "vite build && electron-packager . AccrualFlowEdge --platform=linux --arch=x64 --out=release --overwrite --ignore='^/src' --ignore='^/release' --ignore='node_modules/(?!(better-sqlite3))'",
    "package:win": "vite build && electron-packager . AccrualFlowEdge --platform=win32 --arch=x64 --out=release --overwrite --ignore='^/src' --ignore='^/release'",
    "package:mac": "vite build && electron-packager . AccrualFlowEdge --platform=darwin --arch=x64 --out=release --overwrite --ignore='^/src' --ignore='^/release'"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
