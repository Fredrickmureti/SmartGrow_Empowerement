{
  "name": "accrualflow",
  "version": "1.0.0",
  "description": "AccrualFlow POS Terminal Desktop Application",
  "main": "main.js",
  "author": {
    "name": "AccrualFlow",
    "email": "support@accrualflow.systems"
  },
  "homepage": "https://accrualflow.systems",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "package": "node ../scripts/package-electron.mjs --target=all",
    "package:win": "node ../scripts/package-electron.mjs --target=win",
    "package:mac": "node ../scripts/package-electron.mjs --target=mac",
    "package:linux": "node ../scripts/package-electron.mjs --target=linux"
  },
  "dependencies": {
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^11.0.0",
    "drizzle-orm": "^0.38.0",
    "noble": "^1.9.1",
    "serialport": "^12.0.0",
    "usb": "^2.11.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@electron/rebuild": "^3.6.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.accrualflow.pos-terminal",
    "productName": "AccrualFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "hardware/**/*.js",
      "database/**/*.js",
      "security/**/*.js"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist",
        "filter": ["**/*"]
      }
    ],
    "asar": false,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../public/favicon.svg"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "../public/favicon.svg"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "../public/favicon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
