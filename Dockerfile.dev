# AccrualFlow Development Dockerfile
# Hot-reload enabled development environment

FROM node:20-alpine

WORKDIR /app

# Install dependencies for native modules and development tools
RUN apk add --no-cache \
    libc6-compat \
    git \
    curl

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies
RUN npm install

# Copy source files (will be overridden by volume mount in docker-compose)
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Environment
ENV NODE_ENV=development

# Start Vite dev server with host binding for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
